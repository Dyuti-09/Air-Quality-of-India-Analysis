
    FACT TABLE : fact_stations
    ----------------------------
    CREATE VIEW goldlayer.fact_stations AS

    SELECT 
    sh.stationId,
    sh.date_,
    sh.time_,
    sh.pm2_5,
    sh.pm_10,
    sh.no_,
    sh.no2,
    sh.nox,
    sh.nh3,
    sh.co,
    sh.so2,
    sh.o3,
    sh.benzene,
    sh.toluene,
    sh.xylene,
    sh.aqi,
    sh.aqi_bucket
    FROM silverlayer.station_hour sh    -- Combined the station_day and station_hour table into one table containing common date and station_id
    LEFT JOIN silverlayer.station_day sd
    ON
    sh.stationId=sd.stationId
    AND
    sh.date_=sd.date_;

    FACT TABLE : fact_cities
    ------------------------
    CREATE VIEW goldlayer.fact_cities AS

    SELECT 
           ch.city
          ,ch.record_date
          ,ch.pm2_5
          ,ch.pm_10
          ,ch.no_
          ,ch.no2
          ,ch.nox
          ,ch.nh3
          ,ch.co
          ,ch.so2
          ,ch.o3
          ,ch.benzene
          ,ch.toluene
          ,ch.xylene
          ,ch.aqi
          ,ch.aqi_bucket,
CASE 
            WHEN
            CH.aqi >= 0 AND CH.aqi <=100 THEN '0-100'
            WHEN
            CH.aqi >= 101 AND CH.aqi <=200 THEN '101-200'
            WHEN
            CH.aqi >= 201 AND CH.aqi <=300 THEN '201-300'
            WHEN
            CH.aqi >= 301 AND CH.aqi <=400 THEN '301-400'
            WHEN
            CH.aqi >= 401 AND CH.aqi <=500 THEN '401-500'
            WHEN
            CH.aqi >= 501 AND CH.aqi <=600 THEN '501-600'
            WHEN
            CH.aqi >= 601 AND CH.aqi <=700 THEN '601-700'
            WHEN
            CH.aqi >= 701 AND CH.aqi <=800 THEN '701-800'
            WHEN
            CH.aqi >= 801 AND CH.aqi <=900 THEN '801-900'
            WHEN
            CH.aqi >= 901 AND CH.aqi <=1000 THEN '901-1000'
            ELSE 'OUT OF RANGE'
            END AS 'AQI RANGE'
      FROM silverlayer.city_hour ch      -- Combined the city_day and city_hour table into one table containing common date and city
      left join silverlayer.city_day cd
      on ch.city = cd.city
      and ch.record_date = cd.record_date;

      DIMENSION TABLE : dim_city        -- extracted unique city names to form a seperate dimension table city. This would simplify the data modelling process. 
      CREATE VIEW goldlayer.dim_city AS

      select
      city,
      state_
      from silverlayer.dim_city
      where city_count = 1;

      DIMENSION TABLE : dim_station  
      CREATE VIEW goldlayer.dim_station AS

      select * from silverlayer.dim_station; -- extracted unique station_id names to form a seperate dimension table station. This would simplify the data modelling process. 
  
   
  select * from goldlayer.fact_cities;
  select * from goldlayer.fact_stations;
  select * from goldlayer.dim_city;
  select * from goldlayer.dim_station;
