ETL PROCESS:
--Removal of duplicates
--Data Standardization
--Handling missing data(Null values)
--Data enrichment
-------------------------------------------------------------------------------------------------------------------------------------------
-------------------------------------------------------------------------------------------------------------------------------------------
SELECT 
TRIM(City) AS City,
CONVERT(date,Date_,103) AS Date_, -- Data Standardization : Converting Dates from text to date format
ISNULL(PM2_5,0) AS PM2_5,           
ISNULL(PM10,0) AS PM10,			-- Data enrichment : replacing nulls with zero
ISNULL(NO2,0) AS NO2,
ISNULL(NH3,0) AS NH3,
ISNULL(CO,0) AS CO,
ISNULL(SO2,0) AS SO2,
ISNULL(O3,0) AS O3,
ISNULL(Benzene,0) AS Benzene,
ISNULL(Toluene,0) AS Toluene,
ISNULL(Xylene,0) AS Xylene,
ISNULL(AQI,0) AS AQI,
TRIM(ISNULL(AQI_Bucket,'Data Missing')) AS AQI_Bucket -- Data enrichment : replacing nulls with understandable terms.
FROM raw_data.city_day;

select AQI_Bucket, count(*) As num -- finding null column 
FROM raw_data.station_day
where AQI_Bucket is null
group by AQI_Bucket;


