We have carried out the data cleaning process in this layer and loaded the data into the silver layer:


CREATE OR ALTER PROCEDURE silverlayer.load_silverlayer AS
BEGIN

	IF OBJECT_ID ('silverlayer.station_day','U') IS NOT NULL
	DROP TABLE silverlayer.station_day

	CREATE TABLE silverlayer.station_day
	(
	stationId varchar(50),
	date_ date,
	pm2_5 decimal(10,2),
	pm_10 decimal(10,2),
	no_ decimal(10,2),
	no2 decimal(10,2),
	nox decimal(10,2),
	nh3 decimal(10,2),
	co decimal(10,2),
	so2 decimal(10,2),
	o3 decimal(10,2),
	benzene decimal(10,2),
	toluene decimal(10,2),
	xylene decimal(10,2),
	aqi int,
	aqi_bucket varchar(50)
	)
	PRINT 'LOADING SILVER LAYER'
	PRINT '----------------------------------------------------------';
	PRINT 'INSERT CLEAN DATA INTO silverlayer.station_day TABLE';
	PRINT '----------------------------------------------------------';
	INSERT INTO silverlayer.station_day(
	stationId,
	date_,
	pm2_5 ,
	pm_10 ,
	no_,
	no2,
	nox ,
	nh3,
	co ,
	so2 ,
	o3,
	benzene,
	toluene,
	xylene ,
	aqi,
	aqi_bucket
	)
	Select 
	TRIM(StationId) As station_id, -- removing unwanted spaces
	CONVERT(date,Date_,103) as date_, -- data standardization 
	ISNULL(PM2_5,0) AS pm2_5, -- replacing null values with zero
	ISNULL(PM_10,0) AS pm_10,
	ISNULL(NO_,0) AS no_,
	ISNULL(NO2,0) AS no2,
	ISNULL(NOX,0) AS nox,
	ISNULL(NH3,0) AS nh3,
	ISNULL(CO,0) AS co,
	ISNULL(SO2,0) AS so2,
	ISNULL(O3,0) AS o3,
	ISNULL(Benzene,0) AS benzene,
	ISNULL(Toluene,0) AS toluene,
	ISNULL(Xylene,0) AS xylene,
	ISNULL(AQI,0) AS aqi,
	ISNULL(AQI_Bucket,'Data Missing') AS aqi_bucket
	FROM bronzelayer.station_day;

	IF OBJECT_ID ('silverlayer.station_hour','U') IS NOT NULL
	DROP TABLE silverlayer.station_hour

	CREATE TABLE silverlayer.station_hour
	(
	stationId varchar(50),
	date_ date,
	time_ time,
	pm2_5 decimal(10,2),
	pm_10 decimal(10,2),
	no_ decimal(10,2),
	no2 decimal(10,2),
	nox decimal(10,2),
	nh3 decimal(10,2),
	co decimal(10,2),
	so2 decimal(10,2),
	o3 decimal(10,2),
	benzene decimal(10,2),
	toluene decimal(10,2),
	xylene decimal(10,2),
	aqi int,
	aqi_bucket varchar(50)
	)
	PRINT 'LOADING SILVER LAYER'
	PRINT '----------------------------------------------------------';
	PRINT 'INSERT CLEAN DATA INTO silverlayer.station_hour TABLE';
	PRINT '----------------------------------------------------------';
	INSERT INTO silverlayer.station_hour

	SELECT 
	TRIM(StationID) AS station_id, -- removing unwanted spaces
	CONVERT(date,datetime_,103) as date_, -- data standardization
	CONVERT(varchar(19),CAST(CONVERT(datetime,Datetime_,103) AS TIME),120)  AS time_,-- data standardization
	ISNULL(PM2_5,0) AS pm2_5,-- replacing null values with zero
	ISNULL(PM_10,0) AS pm_10,
	ISNULL(NO_,0) AS no_,
	ISNULL(NO2,0) AS no2,
	ISNULL(NOX,0) AS nox,
	ISNULL(NH3,0) AS nh3,
	ISNULL(CO,0) AS co,
	ISNULL(SO2,0) AS so2,
	ISNULL(O3,0) AS o3,
	ISNULL(Benzene,0) AS benzene,
	ISNULL(Toluene,0) AS toluene,
	ISNULL(Xylene,0) AS xylene,
	ISNULL(AQI,0) AS aqi,
	ISNULL(AQI_Bucket,'Data Missing') AS aqi_bucket
	FROM bronzelayer.station_hour;


	IF OBJECT_ID ('silverlayer.city_day','U') IS NOT NULL
	DROP TABLE silverlayer.city_day

	CREATE TABLE silverlayer.city_day
	(
	city varchar(50),
	record_date date,
	pm2_5 decimal(10,2),
	pm_10 decimal(10,2),
	no_ decimal(10,2),
	no2 decimal(10,2),
	nox decimal(10,2),
	nh3 decimal(10,2),
	co decimal(10,2),
	so2 decimal(10,2),
	o3 decimal(10,2),
	benzene decimal(10,2),
	toluene decimal(10,2),
	xylene decimal(10,2),
	aqi int,
	aqi_bucket varchar(50)
	)
	PRINT 'LOADING SILVER LAYER'
	PRINT '-------------------------------------------------------';
	PRINT 'INSERT CLEAN DATA INTO silverlayer.city_day TABLE';
	PRINT '-------------------------------------------------------';
	INSERT INTO silverlayer.city_day(
	city,
	record_date,
	pm2_5 ,
	pm_10 ,
	no_,
	no2,
	nox ,
	nh3,
	co ,
	so2 ,
	o3,
	benzene,
	toluene,
	xylene ,
	aqi,
	aqi_bucket
	)
	Select 
	TRIM(City) As city, -- removing unwanted spaces
	CONVERT(date,Date_,103) as record_date,-- data standardization
	ISNULL(PM2_5,0) AS pm2_5,-- replacing null values with zero
	ISNULL(PM10,0) AS pm_10,
	ISNULL(NO_,0) AS no_,
	ISNULL(NO2,0) AS no2,
	ISNULL(NOX,0) AS nox,
	ISNULL(NH3,0) AS nh3,
	ISNULL(CO,0) AS co,
	ISNULL(SO2,0) AS so2,
	ISNULL(O3,0) AS o3,
	ISNULL(Benzene,0) AS benzene,
	ISNULL(Toluene,0) AS toluene,
	ISNULL(Xylene,0) AS xylene,
	ISNULL(AQI,0) AS aqi,
	ISNULL(AQI_Bucket,'Data Missing') AS aqi_bucket
	FROM bronzelayer.city_day;


	IF OBJECT_ID ('silverlayer.city_hour','U') IS NOT NULL
	DROP TABLE silverlayer.city_hour

	CREATE TABLE silverlayer.city_hour
	(
	city varchar(50),
	record_date date,
	record_time time,
	pm2_5 decimal(10,2),
	pm_10 decimal(10,2),
	no_ decimal(10,2),
	no2 decimal(10,2),
	nox decimal(10,2),
	nh3 decimal(10,2),
	co decimal(10,2),
	so2 decimal(10,2),
	o3 decimal(10,2),
	benzene decimal(10,2),
	toluene decimal(10,2),
	xylene decimal(10,2),
	aqi int,
	aqi_bucket varchar(50)
	)
	PRINT 'LOADING SILVER LAYER'
	PRINT '--------------------------------------------------------';
	PRINT 'INSERT CLEAN DATA INTO silverlayer.city_hour TABLE';
	PRINT '--------------------------------------------------------';
	INSERT INTO silverlayer.city_hour(
	city,
	record_date,
	record_time,
	pm2_5 ,
	pm_10 ,
	no_,
	no2,
	nox ,
	nh3,
	co ,
	so2 ,
	o3,
	benzene,
	toluene,
	xylene ,
	aqi,
	aqi_bucket
	)
	Select 
	TRIM(City) As city, -- removing unwanted spaces
	CONVERT(date,Date_time,103) as record_date,-- data standardization
	CONVERT(VARCHAR(19),CAST(CONVERT(TIME,Date_time,103) AS TIME),120) as record_time,-- data standardization
	ISNULL(PM2_5,0) AS pm2_5,-- replacing null values with zero
	ISNULL(PM10,0) AS pm_10,
	ISNULL(NO_,0) AS no_,
	ISNULL(NO2,0) AS no2,
	ISNULL(NOX,0) AS nox,
	ISNULL(NH3,0) AS nh3,
	ISNULL(CO,0) AS co,
	ISNULL(SO2,0) AS so2,
	ISNULL(O3,0) AS o3,
	ISNULL(Benzene,0) AS benzene,
	ISNULL(Toluene,0) AS toluene,
	ISNULL(Xylene,0) AS xylene,
	ISNULL(AQI,0) AS aqi,
	ISNULL(AQI_Bucket,'Data Missing') AS aqi_bucket
	FROM bronzelayer.city_hour;

	IF OBJECT_ID ('silverlayer.dim_station','U') IS NOT NULL
	DROP TABLE silverlayer.dim_station

	CREATE TABLE silverlayer.dim_station --Creating seperate dimension table for station details
	(
	station_id varchar(50),
	station_name varchar(50),
	state_ varchar(50)
	)
	PRINT 'LOADING SILVER LAYER'
	PRINT '-----------------------------------------------------';
	PRINT 'INSERT CLEAN DATA INTO silverlayer.dim_station TABLE';
	PRINT '-----------------------------------------------------';
	INSERT INTO silverlayer.dim_station 
	(
	station_id,
	station_name,
	state_
	)
	Select
	StationID as station_id,
	TRIM(LEADING '"' FROM StationName) AS station_name,
	TRIM(TRAILING ',' FROM TRIM(TRAILING 'Inactive' FROM Status_)) AS state_
	from bronzelayer.station_detail;

	IF OBJECT_ID ('silverlayer.dim_city','U') IS NOT NULL
	DROP TABLE silverlayer.dim_city

	CREATE TABLE silverlayer.dim_city( -- Creating seperate dimension table for city details
	city_count int,
	city varchar(50),
	state_ varchar(50)
	)
	PRINT 'LOADING SILVER LAYER'
	PRINT '--------------------------------------------------';
	PRINT 'INSERT CLEAN DATA INTO silverlayer.dim_city TABLE';
	PRINT '--------------------------------------------------';
	INSERT INTO silverlayer.dim_city
	SELECT 
	RANK() over( partition by TRIM(State_) order by TRIM(StationId)) as city_count,
	TRIM(State_) AS city,
	TRIM( TRAILING ','FROM TRIM(TRAILING 'Inactive' FROM Status_)) AS state_
	FROM bronzelayer.station_detail
	;
	
END

EXEC silverlayer.load_silverlayer;


WITH station_count AS -- Removed incorrect data about stations
(
SELECT 
	*,
count(*) over ( partition by StationName order by StationID) as station_dup
FROM bronzelayer.station_detail sd
)
delete from station_count
where station_dup > 1
